{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-review",
  // Staging 與 production 均須由 Cloudflare Access 保護。
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker-entry.ts",
  "access": {
    "dev": {
      "aud": "finance-review-local",
      "identity": {
        "email": "developer@localhost.invalid",
      },
    },
  },
  "vars": {
    "TEAM_DOMAIN": "https://white-leaf-f24d.cloudflareaccess.com",
    "POLICY_AUD": "573f022375260a915558d3af0e7d1a73e9358a3814198b11700ce390eefa5219",
  },
  "routes": [
    {
      "pattern": "finance-staging.hsun.dev",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finance-review-staging",
      "database_id": "72b4525e-77fa-46b1-8ba3-3d793924b7f1",
      "migrations_dir": "d1/migrations",
    },
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "env": {
    "production": {
      "name": "finance-review-production",
      "vars": {
        "TEAM_DOMAIN": "https://white-leaf-f24d.cloudflareaccess.com",
        "POLICY_AUD": "573f022375260a915558d3af0e7d1a73e9358a3814198b11700ce390eefa5219",
      },
      "routes": [
        {
          "pattern": "finance.hsun.dev",
          "custom_domain": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "finance-review-production",
          "database_id": "5d8dea75-e72f-442a-935b-0f116bf2f616",
          "migrations_dir": "d1/migrations",
        },
      ],
    },
  },
}
