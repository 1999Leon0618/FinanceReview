{
  "name": "finance-review",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .next-e2e",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-browsers.mjs",
    "db:init": "tsx scripts/init-db.ts",
    "db:d1:generate": "node scripts/generate-d1-migration.mjs",
    "db:d1:migrate:local": "node scripts/workers.mjs migrate:local",
    "db:d1:migrate:production": "node scripts/workers.mjs migrate:production",
    "dev:workers": "node scripts/workers.mjs dev",
    "build:workers": "node scripts/workers.mjs build",
    "preview:workers": "node scripts/workers.mjs preview",
    "deploy:production": "node scripts/workers.mjs deploy:production",
    "test:workers": "node scripts/test-workers.mjs",
    "test:workers:live": "node scripts/test-workers.mjs --live",
    "check:workers": "npm run build:workers && npm run test:workers"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.34.0",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "vinext": "^1.0.0-beta.9",
    "yahoo-finance2": "^4.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
