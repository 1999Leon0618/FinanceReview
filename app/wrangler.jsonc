{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-review",
  // 正式公開前仍須完成 Cloudflare Access 與自訂網域設定。
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker-entry.ts",
  "routes": [
    {
      "pattern": "finance-staging.hsun.dev",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finance-review-staging",
      "database_id": "72b4525e-77fa-46b1-8ba3-3d793924b7f1",
      "migrations_dir": "d1/migrations",
    },
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
}
